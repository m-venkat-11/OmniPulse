# Copy this file to .env.local and fill in your values
# .env.local is gitignored — never commit your real keys

# Gemini API Key (get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Turso libSQL Database (local file for dev, Turso cloud for prod)
TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=your_turso_auth_token_if_using_cloud

# Sarvam AI API Key for Indic Regional Languages (https://www.sarvam.ai/)
# SARVAM_API_KEY=your_sarvam_api_key_here

